import {
  "Milky2018/lane2/basic",
  "Milky2018/lane2/syntax",
  "moonbitlang/core/list",
}

warnings = "-6"

rule(
  name: "moonyacc",
  command: "$mod_dir/../.mooncakes/moonbitlang/yacc/moonyacc --no-comments $input -o $output && moonfmt -w $output && moonfmt -w $output",
)

dev_build(
  rule: "moonyacc",
  input: "parser.mbty",
  output: "generated_parser.mbt",
)
