%derive<Debug> Token
%derive<Eq> TokenKind
%derive<Hash> TokenKind
%derive<Compare> TokenKind
%position<SourceSpan>
%derive<Debug> ParseError

%start source_file

%token<String> CHAR
%token<String> INT
%token<String> STRING
%token<String> IDENT
%token<String> RESERVED
%token EOF
%token FALSE "false"
%token TRUE "true"
%token STRUCT "struct"
%token ENUM "enum"
%token FN "fn"
%token LET "let"
%token OPEN "open"
%token IF "if"
%token ELSE "else"
%token MATCH "match"
%token BUILTIN "builtin"
%token PLUS "+"
%token MINUS "-"
%token STAR "*"
%token SLASH "/"
%token PERCENT "%"
%token EQEQ "=="
%token BANGEQ "!="
%token LT "<"
%token LTEQ "<="
%token GT ">"
%token GTEQ ">="
%token AMPAMP "&&"
%token BARBAR "||"
%token BANG "!"
%token PIPE "|>"
%token LPAREN "("
%token RPAREN ")"
%token LBRACE "{"
%token RBRACE "}"
%token LBRACKET "["
%token RBRACKET "]"
%token COMMA ","
%token DOT "."
%token COLON ":"
%token COLONCOLON "::"
%token THIN_ARROW "->"
%token FAT_ARROW "=>"
%token EQUAL "="
%token UNDERSCORE "_"

%left "|>"
%left "||"
%left "&&"
%left "==" "!="
%left "<" "<=" ">" ">="
%left "+" "-"
%left "*" "/" "%"
%right UNARY
%left "." "("

%%

source_file -> SourceFile
  : top_level_declarations EOF {
    SourceFile::{ declarations: $1, loc: span($sloc) }
  }
  ;

top_level_declarations -> Array[TopLevelDeclaration]
  : { [] }
  | top_level_declarations top_level_declaration { comma_push($1, $2) }
  ;

top_level_declaration -> TopLevelDeclaration
  : struct_declaration { TopLevelDeclaration::Struct($1) }
  | enum_declaration { TopLevelDeclaration::Enum($1) }
  | function_declaration { TopLevelDeclaration::Function($1) }
  | top_level_let_declaration { TopLevelDeclaration::Let($1) }
  | open_declaration { TopLevelDeclaration::Open($1) }
  ;

struct_declaration -> StructDeclaration
  : "struct" IDENT type_parameters "{" struct_members "}" {
    StructDeclaration::{ name: $2, type_parameters: $3, members: $5, loc: span($sloc) }
  }
  ;

struct_members -> Array[StructMember]
  : { [] }
  | struct_members struct_member { comma_push($1, $2) }
  ;

struct_member -> StructMember
  : field_declaration { StructMember::Field($1) }
  | open_declaration { StructMember::Open($1) }
  ;

field_declaration -> FieldDeclaration
  : IDENT ":" type {
    FieldDeclaration::{ name: $1, type_: $3, loc: span($sloc) }
  }
  ;

enum_declaration -> EnumDeclaration
  : "enum" IDENT type_parameters "{" enum_variants "}" {
    EnumDeclaration::{ name: $2, type_parameters: $3, variants: $5, loc: span($sloc) }
  }
  ;

enum_variants -> Array[EnumVariant]
  : { [] }
  | enum_variants enum_variant { comma_push($1, $2) }
  ;

enum_variant -> EnumVariant
  : IDENT {
    EnumVariant::{ name: $1, payload: [], loc: span($sloc) }
  }
  | IDENT "(" non_empty_type_list ")" {
    EnumVariant::{ name: $1, payload: $3, loc: span($sloc) }
  }
  ;

function_declaration -> FunctionDeclaration
  : "fn" type_parameters IDENT parameters "->" type block_expression {
    FunctionDeclaration::{
      type_parameters: $2,
      name: $3,
      parameters: $4,
      return_type: $6,
      body: $7,
      loc: span($sloc),
    }
  }
  ;

parameters -> Array[Parameter]
  : "(" ")" { [] }
  | "(" non_empty_parameter_list ")" { $2 }
  ;

non_empty_parameter_list -> Array[Parameter]
  : parameter { [ $1 ] }
  | non_empty_parameter_list "," parameter { comma_push($1, $3) }
  ;

parameter -> Parameter
  : IDENT ":" type {
    Parameter::{ name: $1, type_: $3, loc: span($sloc) }
  }
  ;

top_level_let_declaration -> LetDeclaration
  : "let" IDENT ":" type "=" expression {
    LetDeclaration::{ name: Some($2), type_annotation: Some($4), initializer: $6, loc: span($sloc) }
  }
  | "let" ":" type "=" expression {
    LetDeclaration::{ name: None, type_annotation: Some($3), initializer: $5, loc: span($sloc) }
  }
  ;

local_let_declaration -> LetDeclaration
  : "let" IDENT local_type_annotation "=" expression {
    LetDeclaration::{ name: Some($2), type_annotation: $3, initializer: $5, loc: span($sloc) }
  }
  ;

local_type_annotation -> Type?
  : { None }
  | ":" type { Some($2) }
  ;

open_declaration -> OpenDeclaration
  : "open" IDENT {
    OpenDeclaration::{ name: $2, loc: span($sloc) }
  }
  ;

type_parameters -> Array[String]
  : { [] }
  | "[" non_empty_ident_list "]" { $2 }
  ;

non_empty_ident_list -> Array[String]
  : IDENT { [ $1 ] }
  | non_empty_ident_list "," IDENT { comma_push($1, $3) }
  ;

type -> Type
  : named_type { $1 }
  | function_type { $1 }
  | "[" non_empty_ident_list "]" function_type {
    guard $4 is Type::Function(type_parameters=_, parameters~, result~, loc~)
    Type::Function(type_parameters=$2, parameters~, result~, loc~)
  }
  ;

named_type -> Type
  : IDENT {
    Type::Name(name=$1, arguments=[], loc=span($sloc))
  }
  | IDENT "[" type_list "]" {
    Type::Name(name=$1, arguments=$3, loc=span($sloc))
  }
  ;

function_type -> Type
  : "(" type_list ")" "->" type {
    Type::Function(type_parameters=[], parameters=$2, result=$5, loc=span($sloc))
  }
  ;

type_list -> Array[Type]
  : { [] }
  | non_empty_type_list { $1 }
  ;

non_empty_type_list -> Array[Type]
  : type { [ $1 ] }
  | non_empty_type_list "," type { comma_push($1, $3) }
  ;

expression -> Expr
  : expression "|>" expression {
    Expr::Pipeline(left=$1, right=$3, loc=span($sloc))
  }
  | expression "||" expression {
    Expr::Binary(operator=BinaryOperator::Or, left=$1, right=$3, loc=span($sloc))
  }
  | expression "&&" expression {
    Expr::Binary(operator=BinaryOperator::And, left=$1, right=$3, loc=span($sloc))
  }
  | expression "==" expression {
    Expr::Binary(operator=BinaryOperator::Equal, left=$1, right=$3, loc=span($sloc))
  }
  | expression "!=" expression {
    Expr::Binary(operator=BinaryOperator::NotEqual, left=$1, right=$3, loc=span($sloc))
  }
  | expression "<" expression {
    Expr::Binary(operator=BinaryOperator::Less, left=$1, right=$3, loc=span($sloc))
  }
  | expression "<=" expression {
    Expr::Binary(operator=BinaryOperator::LessEqual, left=$1, right=$3, loc=span($sloc))
  }
  | expression ">" expression {
    Expr::Binary(operator=BinaryOperator::Greater, left=$1, right=$3, loc=span($sloc))
  }
  | expression ">=" expression {
    Expr::Binary(operator=BinaryOperator::GreaterEqual, left=$1, right=$3, loc=span($sloc))
  }
  | expression "+" expression {
    Expr::Binary(operator=BinaryOperator::Add, left=$1, right=$3, loc=span($sloc))
  }
  | expression "-" expression {
    Expr::Binary(operator=BinaryOperator::Sub, left=$1, right=$3, loc=span($sloc))
  }
  | expression "*" expression {
    Expr::Binary(operator=BinaryOperator::Mul, left=$1, right=$3, loc=span($sloc))
  }
  | expression "/" expression {
    Expr::Binary(operator=BinaryOperator::Div, left=$1, right=$3, loc=span($sloc))
  }
  | expression "%" expression {
    Expr::Binary(operator=BinaryOperator::Rem, left=$1, right=$3, loc=span($sloc))
  }
  | "-" expression %prec UNARY {
    Expr::Unary(operator=UnaryOperator::Neg, operand=$2, loc=span($sloc))
  }
  | "!" expression %prec UNARY {
    Expr::Unary(operator=UnaryOperator::Not, operand=$2, loc=span($sloc))
  }
  | expression "(" argument_list ")" {
    Expr::Call(callee=$1, arguments=$3, loc=span($sloc))
  }
  | expression "." IDENT {
    Expr::Field(base=$1, name=$3, loc=span($sloc))
  }
  | primary_expression { $1 }
  ;

primary_expression -> Expr
  : INT { Expr::IntLiteral($1, loc=span($sloc)) }
  | STRING { Expr::StringLiteral($1, loc=span($sloc)) }
  | "true" { Expr::BoolLiteral(true, loc=span($sloc)) }
  | "false" { Expr::BoolLiteral(false, loc=span($sloc)) }
  | IDENT { Expr::Var($1, loc=span($sloc)) }
  | qualified_expression { $1 }
  | "(" ")" { Expr::UnitLiteral(loc=span($sloc)) }
  | "(" expression ")" { $2 }
  | block_expression { $1 }
  | if_expression { $1 }
  | match_expression { $1 }
  | function_literal { $1 }
  | builtin_expression { $1 }
  ;

qualified_expression -> Expr
  : IDENT type_arguments "::" "{" struct_literal_fields "}" {
    Expr::StructLiteral(type_name=$1, type_arguments=$2, fields=$5, loc=span($sloc))
  }
  | IDENT type_arguments "::" IDENT variant_arguments {
    Expr::QualifiedVariant(type_name=$1, type_arguments=$2, variant=$4, arguments=$5, loc=span($sloc))
  }
  ;

type_arguments -> Array[Type]
  : { [] }
  | "[" type_list "]" { $2 }
  ;

struct_literal_fields -> Array[StructLiteralField]
  : { [] }
  | non_empty_struct_literal_fields { $1 }
  ;

non_empty_struct_literal_fields -> Array[StructLiteralField]
  : struct_literal_field { [ $1 ] }
  | non_empty_struct_literal_fields "," struct_literal_field { comma_push($1, $3) }
  | non_empty_struct_literal_fields "," { $1 }
  ;

struct_literal_field -> StructLiteralField
  : IDENT {
    StructLiteralField::{ name: $1, value: None, loc: span($sloc) }
  }
  | IDENT ":" expression {
    StructLiteralField::{ name: $1, value: Some($3), loc: span($sloc) }
  }
  ;

variant_arguments -> Array[Expr]
  : { [] }
  | "(" non_empty_argument_list ")" { $2 }
  ;

argument_list -> Array[Expr]
  : { [] }
  | non_empty_argument_list { $1 }
  ;

non_empty_argument_list -> Array[Expr]
  : expression { [ $1 ] }
  | non_empty_argument_list "," expression { comma_push($1, $3) }
  | non_empty_argument_list "," { $1 }
  ;

block_expression -> Expr
  : "{" local_items expression "}" {
    Expr::Block(items=$2, result=$3, loc=span($sloc))
  }
  ;

local_items -> Array[LocalItem]
  : { [] }
  | local_items local_item { comma_push($1, $2) }
  ;

local_item -> LocalItem
  : local_let_declaration { LocalItem::Let($1) }
  | function_declaration { LocalItem::Function($1) }
  | open_declaration { LocalItem::Open($1) }
  ;

if_expression -> Expr
  : "if" expression block_expression "else" block_expression {
    Expr::If(condition=$2, then_branch=$3, else_branch=$5, loc=span($sloc))
  }
  ;

match_expression -> Expr
  : "match" expression "{" match_arms "}" {
    Expr::Match(scrutinee=$2, arms=$4, loc=span($sloc))
  }
  ;

match_arms -> Array[MatchArm]
  : { [] }
  | match_arms match_arm { comma_push($1, $2) }
  ;

match_arm -> MatchArm
  : pattern "=>" expression {
    MatchArm::{ pattern: $1, body: $3, loc: span($sloc) }
  }
  ;

function_literal -> Expr
  : "fn" type_parameters "(" function_literal_parameters ")" return_type_annotation block_expression {
    Expr::FunctionLiteral(type_parameters=$2, parameters=$4, return_type=$6, body=$7, loc=span($sloc))
  }
  ;

function_literal_parameters -> Array[FunctionLiteralParameter]
  : { [] }
  | non_empty_function_literal_parameters { $1 }
  ;

non_empty_function_literal_parameters -> Array[FunctionLiteralParameter]
  : function_literal_parameter { [ $1 ] }
  | non_empty_function_literal_parameters "," function_literal_parameter { comma_push($1, $3) }
  ;

function_literal_parameter -> FunctionLiteralParameter
  : IDENT local_type_annotation {
    FunctionLiteralParameter::{ name: $1, type_annotation: $2, loc: span($sloc) }
  }
  ;

return_type_annotation -> Type?
  : { None }
  | "->" type { Some($2) }
  ;

builtin_expression -> Expr
  : "builtin" "(" STRING ")" {
    Expr::Builtin($3, loc=span($sloc))
  }
  ;

pattern -> Pattern
  : "_" { Pattern::Wildcard(span($sloc)) }
  | INT { Pattern::IntLiteral($1, loc=span($sloc)) }
  | STRING { Pattern::StringLiteral($1, loc=span($sloc)) }
  | "true" { Pattern::BoolLiteral(true, loc=span($sloc)) }
  | "false" { Pattern::BoolLiteral(false, loc=span($sloc)) }
  | IDENT { Pattern::Binding($1, loc=span($sloc)) }
  | IDENT "::" "{" struct_pattern_fields "}" {
    Pattern::Struct(type_name=$1, fields=$4, loc=span($sloc))
  }
  | IDENT "::" IDENT pattern_arguments {
    Pattern::QualifiedVariant(type_name=$1, variant=$3, arguments=$4, loc=span($sloc))
  }
  ;

pattern_arguments -> Array[Pattern]
  : { [] }
  | "(" pattern_list ")" { $2 }
  ;

pattern_list -> Array[Pattern]
  : { [] }
  | non_empty_pattern_list { $1 }
  ;

non_empty_pattern_list -> Array[Pattern]
  : pattern { [ $1 ] }
  | non_empty_pattern_list "," pattern { comma_push($1, $3) }
  | non_empty_pattern_list "," { $1 }
  ;

struct_pattern_fields -> Array[StructPatternField]
  : { [] }
  | non_empty_struct_pattern_fields { $1 }
  ;

non_empty_struct_pattern_fields -> Array[StructPatternField]
  : struct_pattern_field { [ $1 ] }
  | non_empty_struct_pattern_fields "," struct_pattern_field { comma_push($1, $3) }
  | non_empty_struct_pattern_fields "," { $1 }
  ;

struct_pattern_field -> StructPatternField
  : IDENT {
    StructPatternField::{ name: $1, pattern: None, loc: span($sloc) }
  }
  | IDENT ":" pattern {
    StructPatternField::{ name: $1, pattern: Some($3), loc: span($sloc) }
  }
  ;
